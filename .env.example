# .env.example — salin menjadi .env lalu isi nilainya.
# Semua variabel di bawah bersifat opsional, kecuali RC_API_KEY untuk fitur Remote Config.

# ---------- Server ----------
# PORT=9876

# ---------- Remote Config ----------
# API key untuk backend Remote Config (JANGAN di-commit ke repositori)
RC_API_KEY=
# RC_BACKEND_URL=http://127.0.0.1:8003
# RC_DEV_BACKEND_URL=http://127.0.0.1:8003
# RC_PROD_BACKEND_URL=https://example.com
# RC_DEV_SERVER_BACKEND_URL=https://dev.example.com

# ---------- Database ----------
# DB_CLIENT: "pg" (default, butuh PostgreSQL) atau "better-sqlite3" (tanpa pemasangan tambahan)
# Untuk mencoba tanpa PostgreSQL, isi: DB_CLIENT=better-sqlite3
# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=process_manager
# DB_USER=postgres
# DB_PASS=
# Berkas SQLite default: database/process-manager.db (dipakai bila DB_CLIENT=better-sqlite3)
