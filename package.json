    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "knex": "^3.3.0",
    "multer": "^2.2.0",
    "strip-ansi": "^7.2.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "devDependencies": {
