{
  "name": "process-manager",
  "version": "1.0.0",
  "description": "Web-based process manager untuk development Flutter & Laravel",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "dev": "concurrently \"node --watch --env-file-if-exists=.env index.js\" \"cd client && npm run dev\"",
    "dev:backend": "node --watch --env-file-if-exists=.env index.js",
    "dev:frontend": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "migrate": "node --env-file-if-exists=.env -e \"const db = require('./database/db'); db.migrate().then(() => db.destroy()).catch((e) => { console.error(e.message); process.exit(1); })\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "process-manager",
    "devtools",
    "flutter",
    "laravel",
    "express",
    "react"
  ],
  "author": "Adi Bagas Pratama",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "http-proxy-middleware": "^4.2.0",
    "knex": "^3.3.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "strip-ansi": "^7.2.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
